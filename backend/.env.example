APP_ENV=development
APP_NAME="Personalized Travel Itinerary Planner API"
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Options: groq | huggingface | ollama | mock
AI_PROVIDER=mock

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-70B-Instruct

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long!
ROUTING_PROVIDER=none
ROUTING_API_KEY=
