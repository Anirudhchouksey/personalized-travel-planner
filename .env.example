# Application Environment
APP_ENV=development
APP_NAME="Personalized Travel Itinerary Planner"
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Database & Auth (Hosted or Local)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Configuration: groq | huggingface | ollama | mock
AI_PROVIDER=mock

# Groq Cloud API (Recommended primary hosted provider)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face Inference API (Alternative hosted provider)
HUGGINGFACE_API_TOKEN=hf_your_token_here
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-70B-Instruct

# Ollama Local LLM (Offline & local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Backend Security / Token Signing
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# Optional Routing & Geocoding Provider
ROUTING_PROVIDER=none
ROUTING_API_KEY=
